# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# `setup.sh` and `run.sh` will source `.env` automatically if present.
# `.env` itself is git-ignored.

# Your ANL username. Argo authenticates via the OpenAI `user` field rather
# than an API key, so we pass this same string everywhere a key is expected.
# Required for both `setup.sh` (for the chemgraph smoke test) and `run.sh`.
ARGO_USER=your-anl-username

# LLM the agent and the verifier's diagnostic LLM judge use.
# Must be a model in ChemGraph's ARGO_MODEL_MAP — pick one that actually
# exists in Argo's catalog. Cheap & fast: argo:o4-mini. Stronger: argo:gpt-5.
# `argo:gpt-4o-mini` does NOT exist; do not use it.
MODEL=argo:o4-mini

# Per-query timeout inside the chemgraph batch runner. Reaction-energy
# queries can take 2–3 minutes; raise this if you add harder queries.
PER_QUERY_TIMEOUT_SEC=600
